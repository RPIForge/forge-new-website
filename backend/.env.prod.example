# Copy to backend/.env.prod on the server and fill in real values. Never commit .env.prod.
# Generate secrets with:  openssl rand -hex 32

SECRET_KEY=CHANGE_ME
ENVIRONMENT=PRD
ACCESS_TOKEN_EXPIRE_MINUTES=15
BACKEND_CORS_ORIGINS=["https://beta.rpiforge.dev"]
ALLOWED_HOSTS=["beta.rpiforge.dev"]

# Must match database/.env.prod
DEFAULT_DATABASE_HOSTNAME=postgres
DEFAULT_DATABASE_USER=forge
DEFAULT_DATABASE_PASSWORD=CHANGE_ME
DEFAULT_DATABASE_PORT=5432
DEFAULT_DATABASE_DB=forge

# Required by the settings class but not used in production
TEST_DATABASE_HOSTNAME=localhost
TEST_DATABASE_USER=unused
TEST_DATABASE_PASSWORD=unused
TEST_DATABASE_PORT=5432
TEST_DATABASE_DB=unused

# Azure portal > forgesite-comms > Settings > Keys > Connection string
AZURE_COMMUNICATION_CONNECTION_STRING=endpoint=https://...;accesskey=...
